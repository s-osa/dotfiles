#!/bin/bash

# Managed settings from dotfiles repo.
# These keys always overwrite the target; unmanaged keys (e.g. enabledPlugins) are preserved.
MANAGED=$(cat <<'EOF'
{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/1Password/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Write(~/.ssh/**)",
      "Write(~/.gnupg/**)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(docker run *--privileged*)",
      "Bash(docker run *--pid=host*)",
      "Bash(docker run *--pid host*)",
      "Bash(docker run *--network=host*)",
      "Bash(docker run *--network host*)",
      "Bash(docker run *--ipc=host*)",
      "Bash(docker run *--ipc host*)",
      "Bash(docker run *--cap-add*)",
      "Bash(docker run *-v /:*)",
      "Bash(docker run *docker.sock*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(~/.aws/**)",
      "Edit(~/.aws/**)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git stash list *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(* --help *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(curl --head *)",
      "Bash(curl -I *)",
      "Bash(ping *)",
      "Bash(nslookup *)",
      "Bash(dig *)",
      "Bash(host *)",
      "Bash(docker compose *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git fetch *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh label list*)",
      "mcp__plugin_github_github__pull_request_read",
      "mcp__plugin_github_github__issue_read"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
EOF
)

CURRENT=$(cat)

if [ -z "$CURRENT" ]; then
  echo "$MANAGED"
else
  echo "$CURRENT" "$MANAGED" | jq -s '.[0] * .[1]'
fi
